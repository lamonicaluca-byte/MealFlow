# ==============================================================================
# MEALFLOW — variabili d'ambiente
# ==============================================================================
# L'applicazione funziona SENZA nessuna di queste variabili: in loro assenza si
# avvia automaticamente in "modalità demo" (dati in memoria/localStorage,
# autenticazione simulata, realtime simulato, generazione menu con provider AI
# mock). Valorizza le variabili sottostanti solo quando vuoi collegare i
# servizi reali.
# ------------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------
# URL e chiave anonima del progetto Supabase. Se assenti, si usa il data
# provider demo (nessuna chiamata di rete).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chiave service-role: SOLO lato server (route handler / server action), mai
# esposta al client. Usata per il bootstrap del menu settimanale e per
# l'approvazione (route in src/app/api/menu/**), che bypassano le RLS dopo
# aver verificato esplicitamente i permessi dell'utente autenticato.
SUPABASE_SERVICE_ROLE_KEY=

# Se il progetto Supabase è collegato tramite l'integrazione Vercel↔Supabase,
# le variabili potrebbero essere create con un prefisso custom (qui
# "MEALFLOW_") anziché con i nomi standard qui sopra: next.config.mjs e
# src/lib/supabase/env.ts leggono automaticamente anche queste come fallback.
# MEALFLOW_SUPABASE_URL=
# MEALFLOW_SUPABASE_ANON_KEY=
# MEALFLOW_SUPABASE_SERVICE_ROLE_KEY=

# --- Accesso rapido (produzione) ---------------------------------------------
# Con Supabase collegato, il login resta "un clic" (nessuna password digitata
# dall'utente): l'endpoint /api/auth/quick-login esegue un vero accesso
# Supabase Auth per conto dell'utente usando queste credenziali, note SOLO
# lato server. Vanno popolate creando i 3 account reali in Supabase Auth
# (email + password) e riportando qui le stesse credenziali.
QUICK_LOGIN_EMAIL_LUCA=
QUICK_LOGIN_PASSWORD_LUCA=
QUICK_LOGIN_EMAIL_ANITA=
QUICK_LOGIN_PASSWORD_ANITA=
QUICK_LOGIN_EMAIL_CHALIKA=
QUICK_LOGIN_PASSWORD_CHALIKA=

# --- Keep-alive Supabase (produzione) ---------------------------------------
# Segreto condiviso con il Vercel Cron Job (vercel.json → /api/cron/keep-alive,
# schedulato ogni giorno) per evitare che il progetto Supabase free tier vada
# in pausa per inattività. Se valorizzato, la route rifiuta ogni chiamata che
# non porti l'header "Authorization: Bearer <CRON_SECRET>" — che Vercel
# aggiunge automaticamente alle chiamate cron quando questa variabile esiste
# nel progetto. Se assente, la route resta comunque funzionante ma senza
# protezione (accettabile: non modifica nulla, esegue solo una select).
CRON_SECRET=

# --- Provider AI per la generazione del menu --------------------------------
# Se assente (o "mock"), MenuGenerationService usa il MockMenuProvider
# (deterministico, ispirato alla cucina mediterranea, nessuna chiamata
# esterna, gira anche senza chiave API, gratis per sempre).
MEALFLOW_AI_PROVIDER=mock

# Opzione A — Claude (Anthropic), a pagamento in base all'uso:
# MEALFLOW_AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# MEALFLOW_ANTHROPIC_MODEL=claude-sonnet-5   # facoltativo, default sotto

# Opzione B — Google Gemini, GRATIS (livello gratuito di Google AI Studio,
# nessuna carta di credito richiesta): crea la chiave su
# https://aistudio.google.com/app/apikey
# MEALFLOW_AI_PROVIDER=gemini
# GEMINI_API_KEY=
# MEALFLOW_GEMINI_MODEL=gemini-2.5-flash     # facoltativo, default sotto

# --- Notifiche ---------------------------------------------------------------
# Chiavi VAPID per le push notification (Web Push). Se assenti, le notifiche
# restano solo in-app.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Applicazione -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Forza la modalità demo anche se le chiavi Supabase sono presenti (utile per
# ambienti di anteprima/demo pubblici).
NEXT_PUBLIC_FORCE_DEMO_MODE=false
