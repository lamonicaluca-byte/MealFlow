# ==============================================================================
# MEALFLOW — variabili d'ambiente
# ==============================================================================
# L'applicazione funziona SENZA nessuna di queste variabili: in loro assenza si
# avvia automaticamente in "modalità demo" (dati in memoria/localStorage,
# autenticazione simulata, realtime simulato, generazione menu con provider AI
# mock). Valorizza le variabili sottostanti solo quando vuoi collegare i
# servizi reali.
# ------------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------
# URL e chiave anonima del progetto Supabase. Se assenti, si usa il data
# provider demo (nessuna chiamata di rete).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chiave service-role: SOLO lato server (route handler / server action), mai
# esposta al client. Necessaria per operazioni amministrative (inviti,
# cancellazione account, esportazione dati).
SUPABASE_SERVICE_ROLE_KEY=

# --- Provider AI per la generazione del menu --------------------------------
# Se assente, MenuGenerationService usa il MockMenuProvider (deterministico,
# ispirato alla cucina mediterranea, nessuna chiamata esterna).
MEALFLOW_AI_PROVIDER=mock
# Se in futuro si usa un provider reale (es. Anthropic), impostare:
# MEALFLOW_AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# --- Notifiche ---------------------------------------------------------------
# Chiavi VAPID per le push notification (Web Push). Se assenti, le notifiche
# restano solo in-app.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Applicazione -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Forza la modalità demo anche se le chiavi Supabase sono presenti (utile per
# ambienti di anteprima/demo pubblici).
NEXT_PUBLIC_FORCE_DEMO_MODE=false
